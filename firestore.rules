rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // プロフィール（自宅・最寄り駅）：本人だけが読み書きできる
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 旅行プロジェクト
    match /projects/{pid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      // 招待リンク（旅行のID）を知っている人は、参加前に中身を確認できる
      allow get: if signedIn();
      // 一覧は自分が参加している旅行だけ
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // 作成者は自分をメンバーに含める
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      // メンバーは編集できる。メンバー以外は「自分を1人追加する」参加の操作だけできる
      allow update: if isMember() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','memberInfo','starts','updatedAt','updatedBy'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members);
      // 削除は作成者だけ
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // ここから下は「旅のしおり」の共有保存（2026-10 追加）
      function memberOfTrip() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(pid)).data.members;
      }
      // しおりの文字（都道府県ごと）：旅行のメンバーだけが読み書きできる
      match /journals/{slug} {
        allow read, delete: if memberOfTrip();
        allow create, update: if memberOfTrip()
          && slug.matches('[a-z]{3,12}')
          && request.resource.data.keys().hasOnly(['data', 'rev', 'updatedAt', 'updatedBy', 'by'])
          && request.resource.data.data is map
          && request.resource.data.rev is int
          && request.resource.data.by == request.auth.uid;
      }
      // しおりの写真（1枚ずつ。JPEG・約0.9MBまで）：旅行のメンバーだけが読み書きできる
      match /journalPhotos/{photoId} {
        allow read, delete: if memberOfTrip();
        allow create, update: if memberOfTrip()
          && photoId.matches('[a-z]{3,12}_p[0-9a-z]{10,40}')
          && request.resource.data.keys().hasOnly(['slug', 'ref', 'src', 'by', 'at'])
          && request.resource.data.src is string
          && request.resource.data.src.size() <= 950000
          && request.resource.data.src[0:23] == 'data:image/jpeg;base64,'
          && request.resource.data.by == request.auth.uid;
      }
    }
  }
}
